load(":lint_levels.bzl", "CLIPPY_ALLOW", "CLIPPY_AUTOFIX", "CLIPPY_DENY")

rust_package_local.set_rustc_flags(
    ["-W" + x for x in CLIPPY_DENY]
    + ["-A" + x for x in CLIPPY_ALLOW + CLIPPY_AUTOFIX]
    + [
        "--cfg=buck_build",
        # Reuse upstream crates' instantiations of generic functions and async bodies
        # instead of re-emitting them in every dependent crate. Off by default at this
        # optimization level; measured as a 30% reduction in codegen time across the
        # tree and about 10% in link time. The runtime cost: a shared instantiation is
        # a call across crates, not an inlining candidate, so small generic helpers on
        # hot paths (`Value::downcast_ref` and the view constructors around it) carry
        # `#[inline]`, which opts them out of sharing.
        "-Zshare-generics=yes",
    ]
)

rust_package_local.set_clippy_configuration("//buck2:clippy_config")

rust_package_local.set_miri_flags(
    [
        # Tree Borrows is the aliasing model the Rust project is converging on; the default,
        # Stacked Borrows, rejects patterns Tree Borrows accepts. Matches starlark-rust's GitHub CI.
        "-Zmiri-tree-borrows",
    ] + select({
        # No integer-to-pointer casts: pointers that go through integers lose their provenance, and
        # with it the checking that is the point of running Miri. A target can opt out with
        # `test_miri_flags = ["-Zmiri-permissive-provenance"]` (`miri_flags` on a `rust_unittest`).
        # A test that parks threads interpreted hits a cast in `parking_lot_core`'s wait queue
        # (`word_lock.rs`); such tests are ignored under Miri instead.
        "DEFAULT": ["-Zmiri-strict-provenance"],
        # On Apple targets `ctor` (which `allocative`'s `#[root]` pulls into every test binary)
        # registers a constructor of its own that walks a link section through an
        # integer-to-pointer cast (`link-section`'s `launder_pointer_provenance`). Miri runs it
        # before `main`, so under strict provenance no test binary gets as far as listing its
        # tests. Linux enforces strictness for the whole tree; macOS keeps the aliasing checks and
        # gives up the provenance one.
        "ovr_config//os:macos": ["-Zmiri-permissive-provenance"],
    })
)

with_rust_workspace(
    targets = [
        # buildifier: keep sorted
        "//buck2/app/buck2:buck2-bin",
        "//buck2/app/buck2_action_impl_tests:buck2_action_impl_tests",
