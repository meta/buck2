oncall("build_infra")

keystore(
    name = "debug",
    properties = "debug.keystore.properties",
    store = "debug.keystore",
)

android_binary(
    name = "demoapp_debug",
    keystore = ":debug",
    # NOTE: If you use `manifest` attribute, buck2 will use the manifest file as-is.
    # With `manifest_skeleton`, buck2 will merge all manifests in the graph using Manifest Merger.
    # See: https://developer.android.com/build/manage-manifests
    manifest_skeleton = "src/main/AndroidManifest.xml",
    use_split_dex = True,
    deps = [
        ":res",
        "//app/src/main/java/com/facebook/demoapp/ui:ui",
    ],
)

# Release build: ProGuard with the Android default optimized config (shrinking, optimization,
# obfuscation), as `minifyEnabled true` with `proguard-android-optimize.txt` in Gradle.
android_binary(
    name = "demoapp_release",
    android_sdk_proguard_config = "optimized",
    keystore = ":debug",
    manifest_skeleton = "src/main/AndroidManifest.xml",
    package_type = "release",
    use_split_dex = True,
    deps = [
        ":res",
        "//app/src/main/java/com/facebook/demoapp/ui:ui",
    ],
)

# App bundle (.aab) for Google Play. bundletool requires a version code, which
# `manifest_entries` sets here, as `versionCode` in Gradle's `defaultConfig`.
android_bundle(
    name = "demoapp_bundle",
    keystore = ":debug",
    manifest_entries = {
        "version_code": 1,
        "version_name": "1.0",
    },
    manifest_skeleton = "src/main/AndroidManifest.xml",
    primary_dex_patterns = ["^com/facebook/demoapp/"],
    use_split_dex = True,
    deps = [
        ":res",
        "//app/src/main/java/com/facebook/demoapp/ui:ui",
    ],
)

android_resource(
    name = "res",
    package = "com.facebook.demoapp",
    res = "src/main/res",
    visibility = ["PUBLIC"],
)

robolectric_test(
    name = "tests",
    srcs = glob(["src/test/**/*.kt"]),
    language = "KOTLIN",
    manifest = "src/test/resources/TestAndroidManifest.xml",
    robolectric_runtime_dependencies = ["//app/libs/org/robolectric/android-all-instrumented:android-all-instrumented"],
    deps = [
        "//app/libs/junit/junit:junit",
        "//app/libs/org/robolectric/robolectric:robolectric",
        "//app/src/main/java/com/facebook/demoapp/model:model",
    ],
)

android_library(
    name = "android_tests_lib",
    srcs = glob(["src/androidTest/**/*.kt"]),
    language = "KOTLIN",
    deps = [
        "//app/libs/androidx/test/monitor:monitor",
        "//app/libs/junit/junit:junit",
    ],
)

# The test APK, as `src/androidTest` in Gradle: it holds the tests and the test
# runner, and runs against `:demoapp_debug`, whose classes it leaves out.
android_instrumentation_apk(
    name = "android_tests_apk",
    apk = ":demoapp_debug",
    manifest = "src/androidTest/AndroidManifest.xml",
    deps = [
        ":android_tests_lib",
        "//app/libs/androidx/test/runner:runner",
    ],
)

# `buck2 run //app:android_tests` installs both APKs on the device or emulator
# that `adb` reaches and runs the tests there.
android_instrumentation_test(
    name = "android_tests",
    apk = ":android_tests_apk",
)
