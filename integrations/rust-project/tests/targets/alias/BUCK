load("@fbcode_macros//build_defs:native_rules.bzl", "alias")
load("@fbsource//tools/build_defs:rust_library.bzl", "rust_library")

oncall("rust_foundation")

rust_library(
    name = "l",
    srcs = ["lib.rs"],
    unittests = False,
)

alias(
    name = "l_alias",
    actual = ":l",
)

alias(
    name = "empty_alias",
    actual = select({
        "DEFAULT": None,
        "ovr_config//cpu/constraints:riscv64": ":l",
    }),
)

alias(
    name = "empty_alias_alias",
    actual = ":empty_alias",
)
