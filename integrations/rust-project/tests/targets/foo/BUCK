load("@fbcode_macros//build_defs:native_rules.bzl", "buck_filegroup")
load("@fbsource//tools/build_defs:rust_binary.bzl", "rust_binary")
load("@fbsource//tools/build_defs:rust_library.bzl", "rust_library")
load("@fbsource//tools/build_defs:rust_unittest.bzl", "rust_unittest")
load(":wrapper.bzl", "custom_rust_test")

oncall("rust_foundation")

rust_library(
    name = "a",
    srcs = ["lib_a.rs"],
    crate_root = "lib_a.rs",
    deps = ["//buck2/integrations/rust-project/tests/targets/bar:c"],
)

rust_library(
    name = "b",
    srcs = ["lib_b.rs"],
    crate_root = "lib_b.rs",
    deps = ["//buck2/integrations/rust-project/tests/targets/bar:d"],
)

rust_library(
    name = "e",
    srcs = ["lib_e.rs"],
    crate_root = "lib_e.rs",
    deps = [":f"],
)

rust_library(
    name = "f",
    srcs = ["lib_f.rs"],
    crate_root = "lib_f.rs",
)

rust_library(
    name = "g_with_compatibility",
    srcs = ["lib_g.rs"],
    crate_root = "lib_g.rs",
    target_compatible_with = ["ovr_config//cpu/constraints:riscv64"],
)

buck_filegroup(
    name = "g_filegroup",
    srcs = ["gen_g.rs"],
)

rust_library(
    name = "g_with_mapped_srcs",
    srcs = ["lib_g.rs"],
    crate_root = "lib_g.rs",
    mapped_srcs = {
        ":g_filegroup": "src/generated.rs",
        "mapped_g.rs": "src/mapped.rs",
    },
    target_compatible_with = ["ovr_config//cpu/constraints:riscv64"],
)

rust_library(
    name = "g_with_generated_srcs",
    srcs = [
        "lib_g.rs",
        ":g_filegroup",
    ],
    crate_root = "lib_g.rs",
    target_compatible_with = ["ovr_config//cpu/constraints:riscv64"],
)

rust_binary(
    name = "binary",
    srcs = ["main.rs"],
)

rust_unittest(
    name = "native_test",
    srcs = ["test.rs"],
    crate_root = "test.rs",
)

custom_rust_test(
    name = "wrapped_test",
    srcs = ["test.rs"],
    crate_root = "test.rs",
)
