# @oss-disable[end= ]: load("@prelude//python/meta_only:config.bzl", "DEFAULT_PY_VERSION")
load("@prelude//python:typing.bzl", "DEFAULT_PY_VERSION") # @oss-enable
load("@prelude//utils:source_listing.bzl", "source_listing")
