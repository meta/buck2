oncall("build_infra")

source_listing()

prelude = native

cxx_internal_tools(
    name = "internal_tools",
    visibility = ["PUBLIC"],
)

CONSTRUCTION_INTERPRETER = "fbcode//buck2/platform/python:interpreter-linux-stage0-{}".format(DEFAULT_PY_VERSION)

[
    prelude.python_bootstrap_binary_stage0(
        name = name + "-construction",
        interpreter = CONSTRUCTION_INTERPRETER,
        main = name + ".py",
    )
    for name in [
        "check_nonempty_output",
        "clang_tidy_wrapper",
        "concatenate_diagnostics",
        "filter_argsfile",
        "make_comp_db",
        "remap_cwd",
        "shlib_interface_link_wrapper",
        "stderr_to_file",
        "stub_header_unit",
    ]
]

prelude.python_bootstrap_binary_stage0(
    name = "dep_file_processor-construction",
    interpreter = CONSTRUCTION_INTERPRETER,
    main = "dep_file_processor.py",
    deps = [":dep_file_processors"],
)

prelude.python_bootstrap_binary_stage0(
    name = "hmap_wrapper.py-construction",
    interpreter = CONSTRUCTION_INTERPRETER,
    main = "hmap_wrapper.py",
)

prelude.command_alias(
    name = "hmap_wrapper-construction",
    args = [
        "--hmap-tool=$(location prelude//third-party/hmaptool:hmaptool)",
    ],
    exe = ":hmap_wrapper.py-construction",
    labels = ["buck2-only"],
)

