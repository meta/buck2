load("@prelude//utils:source_listing.bzl", "source_listing")

oncall("build_infra")

source_listing()

erlang_application(
    name = "test_binary",
    srcs = glob([
        "src/*.erl",
        "src/*.hrl",
    ]),
    applications = [
        "kernel",
        "stdlib",
        "prelude//erlang/common_test/common:common",
        "prelude//erlang/common_test/cth_hooks:cth_hooks",
        "prelude//erlang/common_test/test_exec:test_exec",
    ],
    erl_opts = [
        "+debug_info",
        "+warnings_as_errors",
    ],
    includes = glob(["include/*.hrl"]),
    use_global_parse_transforms = False,
    visibility = ["PUBLIC"],
)

erlang_tests(
    contacts = ["build_infra"],
    labels = ["unit"],
    suites = ["test/test_binary_SUITE.erl"],
    deps = [
        "stdlib",
        ":test_binary",
        ":test_binary_fixtures",
    ],
)

erlang_application(
    name = "test_binary_fixtures",
    srcs = glob(["test/fixtures/*.erl"]),
    applications = ["//erlang/common_test/common:common"],
    labels = ["test_application"],
)
