load("@prelude//utils:source_listing.bzl", "source_listing")
load(":source_maps.bzl", "named_srcs", "source_keyed_srcs")

oncall("windows_ide_support")

source_listing()

source_keyed_srcs(
    name = "source_keyed_srcs",
    srcs = {
        "source_a.c": None,
        "source_b.c": "source_b.patch",
    },
)

named_srcs(
    name = "named_srcs",
    srcs = {"renamed.c": "source_a.c"},
)
