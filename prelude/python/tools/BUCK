# Type checking target for Python tool scripts.
prelude.python_library(
    name = "scripts-typing",
    srcs = [
        "__test_main__.py",
        "compile.py",
        "create_link_tree.py",
        "create_manifest_for_source_dir.py",
        "extract.py",
        "fail_with_message.py",
        "gather_libpython_symbols.py",
        "gen_bytecode_bundle.py",
        "generate_static_extension_info.py",
        "make_py_package_inplace.py",
        "make_py_package_manifest_module.py",
        "make_py_package_modules.py",
        "make_source_db.py",
        "make_source_db_no_deps.py",
        "patchelf.py",
        "static_extension_finder.py",
        "type_check_result_to_validation.py",
        "wheel.py",
    ]
    + glob(
        ["tests/**/*.py"],
        # Imports `__test_main__.py` under the name its test target gives it.
        exclude = ["tests/test_main_test.py"],
    ),
    base_module = "",
    typing = True,
    deps = [
        "fbsource//third-party/pypi/colorama:colorama",
    ],
)

prelude.python_test(
