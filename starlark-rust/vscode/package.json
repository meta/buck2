{
    "name": "starlark",
    "description": "A Starlark language server",
    "extensionKind": [
        "workspace"
    ],
    "author": "Facebook",
    "license": "Apache2",
    "version": "1.0.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/facebook/starlark-rust"
    },
    "publisher": "facebook",
    "categories": [],
    "keywords": [
        "multi-root ready"
    ],
    "engines": {
        "vscode": "^1.82.0"
    },
    "activationEvents": [
        "onLanguage:starlark",
        "onCommand:starlark.restartLanguageServer"
    ],
    "main": "./client/out/extension",
    "contributes": {
        "languages": [
            {
                "id": "starlark",
                "aliases": [
                    "Starlark",
                    "skylark",
                    "Skylark"
                ],
                "extensions": [
                    ".star",
                    ".sky",
                    ".bxl",
                    ".bzl",
                    ".bazel"
                ],
                "filenames": [
                    "BUILD",
                    "WORKSPACE",
                    "BUCK",
                    "BUCK.v2",
                    "BUILD_DEFS",
                    "DEFS",
                    "TARGETS",
                    "TARGETS.v2",
                    "PACKAGE"
                ],
                "configuration": "./syntaxes/starlark.configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "starlark",
                "scopeName": "source.starlark",
                "path": "./syntaxes/starlark.tmLanguage.json"
            }
        ],
        "breakpoints": [
            {
                "language": "starlark"
            }
        ],
        "debuggers": [
            {
                "type": "starlark",
                "label": "Starlark Debug",
                "program": "/usr/bin/env",
                "args": [
                    "starlark",
                    "--dap"
                ],
                "languages": [
                    "starlark"
                ],
                "configurationAttributes": {
                    "launch": {
                        "properties": {
                            "program": {
                                "type": "string",
                                "description": "The program to debug.",
                                "default": "${file}"
                            }
                        }
                    }
                },
                "initialConfigurations": [
                    {
                        "type": "starlark",
                        "request": "launch",
                        "name": "Launch Program",
                        "program": "${file}"
                    }
                ]
            }
        ],
        "commands": [
            {
                "command": "starlark.restartLanguageServer",
                "title": "Starlark: Restart starlark language server"
            }
        ],
        "configuration": {
            "properties": {
                "starlark.lspPath": {
                    "type": "string",
                    "default": "starlark",
                    "description": "The path to the binary to invoke (possibly on the path) for the plugin to invoke that handles LSP over stdin/stdout"
                },
                "starlark.lspArguments": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "--lsp"
                    ],
                    "description": "Additional arguments that should be passed to the binary at starlark.lspPath"
                },
                "starlark.enableGotoDefinition": {
                    "type": "boolean",
                    "default": true,
                    "description": "Whether to ask the LSP server to enable Goto Definition functionality"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -b",
        "watch": "tsc -b -w"
    },
    "devDependencies": {
        "@types/mocha": "^9.0.0",
        "@types/node": "^16.10.2",
        "@typescript-eslint/parser": "^8.62.1",
        "eslint": "^10.6.0",
        "mocha": "^11.1.0",
        "typescript": "^4.4.3"
    },
    "dependencies": {
        "@vscode/vsce": "^4.0.0",
        "vscode-languageclient": "^9.0.1"
    },
    "overrides": {
        "minimatch": ">=3.1.3",
        "serialize-javascript": ">=7.0.3",
        "underscore": ">=1.13.8",
        "lodash": ">=4.17.23",
        "picomatch": ">=2.3.2",
        "qs": ">=6.14.2",
        "tmp": ">=0.2.7",
        "fast-uri": ">=3.1.8 <4.0.0",
        "brace-expansion": ">=5.0.12",
        "markdown-it": ">=14.3.2 <15.0.0",
        "linkify-it": ">=5.0.2 <6.0.0",
        "js-yaml": ">=4.3.2 <5.0.0"
    }
}
