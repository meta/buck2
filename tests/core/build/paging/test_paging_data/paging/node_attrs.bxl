def _main(ctx: bxl.Context):
    # `--run` is not read. It makes each run a different BXL, so that the script runs again.
    lines = []
    for node in ctx.cquery().deps("root//fan:fan_root"):
        attrs = node.attrs_lazy()
        lines.append(
            "{} {} {}".format(
                node.label.raw_target(),
                attrs.get("name").value(),
                len(attrs.get("deps").value()),
            )
        )
    for line in sorted(lines):
        ctx.output.print(line)

main = bxl_main(
    cli_args = {
        "run": cli_args.string(),
    },
    impl = _main,
)
