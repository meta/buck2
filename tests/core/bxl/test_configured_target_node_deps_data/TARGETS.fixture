execution_platforms(
    name = "platforms",
)

constraint_setting(
    name = "os",
)

constraint_value(
    name = "linux",
    constraint_setting = ":os",
)

constraint_value(
    name = "macos",
    constraint_setting = ":os",
)

platform(
    name = "linux_platform",
    constraint_values = [":linux"],
)

stub(
    name = "dep",
)

stub(
    name = "linux_dep",
)

stub(
    name = "macos_dep",
)

stub(
    name = "tool",
)

stub_toolchain(
    name = "toolchain",
)

stub(
    name = "node",
    default_target_platform = ":linux_platform",
    deps = [":dep"] + select({
        ":linux": [":linux_dep"],
        ":macos": [":macos_dep"],
    }),
    exec_deps = [":tool"],
    toolchain_deps = [":toolchain"],
)
