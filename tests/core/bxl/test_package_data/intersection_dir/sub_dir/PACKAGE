# Declares its own visibility but does NOT call enforce_visibility_intersection().
# Its `visibility_intersection` is therefore inherited from the ancestor `intersection_dir` and is
# distinct from this package's own `visibility`, exercising intersection propagation.
package(
    visibility = ["root//other:thing"],
)
