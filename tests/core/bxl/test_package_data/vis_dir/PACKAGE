# Declare explicit visibility and within_view so the `bxl.read_package_*`
# functions have a non-default value to read here, while `root//` keeps the
# defaults (visibility `[]`, within_view `["PUBLIC"]`). The `target_name_glob(...)`
# entry exercises the JSON-object rendering path of a non-string pattern.
package(
    visibility = ["root//bar_dir/...", "root//sub_dir:", target_name_glob(["*-test"])],
    within_view = ["root//..."],
)
