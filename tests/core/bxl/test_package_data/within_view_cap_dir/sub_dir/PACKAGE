# Declares its own `within_view` but does NOT call
# `enforce_within_view_intersection()`. Its `within_view_cap` is therefore
# inherited from the ancestor `within_view_cap_dir` and is distinct from this
# package's own `within_view`, exercising cap propagation.
package(
    within_view = ["root//other/..."],
)
