load("@fbsource//tools/build_defs:rust_library.bzl", "rust_library")

oncall("build_infra")

# The file watcher tests that `tests/core/io` runs against each file watcher and file system; see
# `io/lib.rs`. Like the tests, it builds with buck only.
rust_library(
    name = "io",
    srcs = glob(["io/*.rs"]),
    autocargo = {"ignore_rule": True},
    crate = "common_io",
    crate_root = "io/lib.rs",
    deps = [
        "fbcode//buck2/tests/e2e_util/rust:buck2_e2e",
        "fbsource//third-party/rust:anyhow",
        "fbsource//third-party/rust:serde_json",
        "fbsource//third-party/rust:tokio",
    ],
)
