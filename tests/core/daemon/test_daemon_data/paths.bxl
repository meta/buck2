def _paths_impl(ctx):
    print("evaluating tenant paths")  # buildifier: disable=print
    root = ctx.root()
    output = ctx.bxl_actions().actions.write("root.txt", root, has_content_based_path = False)
    ctx.output.print(json.encode({"root": root}))
    ctx.output.print(ctx.output.ensure(output).abs_path())

paths = bxl_main(impl = _paths_impl, cli_args = {})
