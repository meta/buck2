[cells]
  root = .

[buildfile]
  name = TARGETS.fixture

[buck2]
  load_as_allowlist = *.lock

[project]
  # Isolated mini-repos, each selected via data_dir by its own tests; ignored
  # so the default `//...` tests skip them.
  ignore = cross_cell,cross_package,cross_package_json,cross_package_toml,format,redundant
