load("//rules:rules.bzl", "foo_basic_print", "foo_binary", "foo_buildable", "foo_genrule")

foo_binary(
    name = "bin",
    visibility = ["PUBLIC"],
)

foo_genrule(
    name = "data",
    cmd = "$(exe :genrule_binary)",
    visibility = ["PUBLIC"],
)

foo_genrule(
    name = "foo_toolchain",
    cmd = "",
    visibility = ["PUBLIC"],
)

foo_genrule(
    name = "genrule_binary",
    cmd = "",
    visibility = ["PUBLIC"],
)

foo_buildable(
    name = "buildable",
    content = "FOO",
    out = "out.txt",
)

foo_basic_print(
    name = "print",
    visibility = ["PUBLIC"],
)
