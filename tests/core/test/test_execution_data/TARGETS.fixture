load(":rules.bzl", "simple_test")

simple_test(name = "test")

simple_test(
    name = "cacheable_test",
    seed = read_config("test", "seed", ""),
    supports_test_execution_caching = True,
)

simple_test(
    name = "writes_output",
    writes_output = True,
)

simple_test(
    name = "records_coding_agent_metadata",
    records_coding_agent_metadata = True,
)

simple_test(
    name = "sets_coding_agent_metadata",
    coding_agent_metadata = "id=rule",
    records_coding_agent_metadata = True,
)
