load("@fbcode//buck2/tests:buck_e2e.bzl", "buck2_e2e_test")

oncall("build_infra")

buck2_e2e_test(
    name = "test_git_fetch",
    srcs = ["test_git_fetch.rs"],
    data_dir = "test_git_fetch_data",
)

buck2_e2e_test(
    name = "test_prelude_rules",
    srcs = ["test_prelude_rules.rs"],
    data_dir = "test_prelude_rules_data",
    # `cpe::x2p` resolves `localhost` incorrectly, and the downloads fail.
    env = {"CPE_RUST_X2P_SUPPORTS_VPNLESS": "0"},
    deps = [
        "fbsource//third-party/rust:hex",
        "fbsource//third-party/rust:sha2",
    ],
)

buck2_e2e_test(
    name = "test_prelude_tools",
    srcs = ["test_prelude_tools.rs"],
    data_dir = "test_prelude_tools_data",
    # The clang of the fbcode platform, for the tests that compile with a real clang; they run
    # on Linux only.
    env = {
        "CLANG": select({
            "DEFAULT": "",
            "ovr_config//os:linux": "$(location fbcode//third-party-buck/platform010/build/llvm-fb/21:bin/clang)",
        }),
    },
)
