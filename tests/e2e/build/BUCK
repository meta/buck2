load("@fbcode//buck2/tests:buck_e2e.bzl", "buck2_e2e_test")
load("@fbsource//tools/build_defs:testpilot_defs.bzl", "tpx_labels")
load("@fbsource//tools/target_determinator/macros:ci.bzl", "ci")

oncall("build_infra")

buck2_e2e_test(
    name = "test_build_isolated",
    srcs = ["test_build_isolated.rs"],
    data = "//buck2/tests/targets:isolated_targets",
    env = {
        # `cpe::x2p` resolves `localhost` incorrectly, and the download tests fail.
        "CPE_RUST_X2P_SUPPORTS_VPNLESS": "0",
        "OVR_CONFIG": "1",
        "PRELUDE": "$(location prelude//:prelude)",
    },
    serialize_test_cases = False,
    deps = ["fbsource//third-party/rust:regex"],
)

buck2_e2e_test(
    name = "test_build_inplace",
    srcs = ["test_build_inplace.rs"],
    require_nano_prelude = True,
)

buck2_e2e_test(
    name = "test_build_id_inplace",
    srcs = ["test_build_id_inplace.rs"],
    test_with_deployed_buck2 = True,
)

buck2_e2e_test(
    name = "test_worker",
    srcs = ["test_worker.rs"],
    labels = [tpx_labels.long_running],
)

buck2_e2e_test(
    name = "test_remote_worker",
    srcs = ["test_remote_worker.rs"],
    labels = [tpx_labels.long_running],
    skip_for_os = [
        "darwin",
        "windows",
    ],
    test_with_deployed_buck2 = False,
    use_compiled_buck2_client_and_tpx = True,
)

buck2_e2e_test(
    name = "test_action_digest",
    srcs = ["test_action_digest.rs"],
    # Version-bump diffs rewrite these files; the test must run on them so
    # the candidate is compared against the outgoing version before it ships.
    ci_srcs = [
        "tools/buck2-versions/previous",
        "tools/buck2-versions/stable",
    ],
    # A digest change turns every action in the graph into a cache miss, so
    # the first run after one is slow by nature. On diffs a TPX timeout is a
    # non-blocking warning, so the budget has to be large enough for the test
    # to reach its own verdict.
    labels = [tpx_labels.long_running]
    + ci.labels(
        ci.for_schedules([ci.diff, ci.land], [ci.linux(ci.opt())]),
        ci.for_schedules([ci.land], [ci.mac(ci.aarch64(ci.opt()))]),
    ),
    # This test is currently broken on Windows due to rustc_link non-determinism
    # https://fb.workplace.com/groups/346627374465346/permalink/511477684646980/
    skip_for_os = [
        "windows",
    ],
    # DO NOT Modify or add more test flags,
    # this is used to gate changes that modify action_digest.
    # Changing it will prevent the test from working properly
    test_with_compiled_buck2 = True,
)
