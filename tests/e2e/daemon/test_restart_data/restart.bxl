# The first attempt at a tag marks itself started and waits for the gate to be released.
_WAIT_AT_GATE = """
import pathlib, sys, time
gate = pathlib.Path(sys.argv[1])
started = gate / sys.argv[2]
if not started.exists():
    started.touch()
    while not (gate / "released").exists():
        if not gate.exists():
            sys.exit("the gate is gone")
        time.sleep(0.05)
pathlib.Path(sys.argv[3]).write_text("ready")
"""

def _run(ctx, streaming):
    if streaming:
        ctx.output.stream("prefix:" + ctx.cli_args.tag)
    actions = ctx.bxl_actions().actions
    output = actions.declare_output("gate-" + ctx.cli_args.tag, has_content_based_path = False)
    actions.run(
        cmd_args(ctx.cli_args.python, "-c", _WAIT_AT_GATE, ctx.cli_args.gate, ctx.cli_args.tag, output.as_output()),
        category = "coordinated_restart_gate",
        local_only = True,
    )
    ctx.output.ensure(output)
    ctx.output.print("done:" + ctx.cli_args.tag)

def _gated(ctx):
    _run(ctx, False)

def _streaming(ctx):
    _run(ctx, True)

_CLI_ARGS = {
    "gate": cli_args.string(),
    "python": cli_args.string(),
    "tag": cli_args.string(),
}

gated = bxl_main(impl = _gated, cli_args = _CLI_ARGS)

streaming = bxl_main(impl = _streaming, cli_args = _CLI_ARGS)
