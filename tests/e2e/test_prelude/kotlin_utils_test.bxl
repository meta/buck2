load("@prelude//:asserts.bzl", "asserts")
load("@prelude//toolchains/android/tools:kotlin_utils.bzl", "kotlin_implementation_detail_opt_in_args", "kotlin_version_at_least")

def _test(ctx: bxl.Context):
    cases = [
        ("2.3.21", False, False),
        ("2.4.21", True, False),
        ("2.5.0-Beta2", True, True),
        ("2.5.0-RC1", True, True),
        ("2.5.0", True, True),
        ("2.5.1", True, True),
        ("2.5-Beta2", True, True),
        ("2.10.0", True, True),
        ("3.0.0", True, True),
        ("1.9.25", False, False),
        ("", False, False),
        ("2", False, False),
        ("invalid", False, False),
    ]
    for version, at_least_2_4, at_least_2_5 in cases:
        asserts.equals(at_least_2_4, kotlin_version_at_least(2, 4, version), version)
        asserts.equals(at_least_2_5, kotlin_version_at_least(2, 5, version), version)
        expected_args = ["-opt-in=org.jetbrains.kotlin.psi.KtImplementationDetail"] if at_least_2_5 else []
        asserts.equals(expected_args, kotlin_implementation_detail_opt_in_args(version), version)
    ctx.output.print("{} Kotlin version cases passed".format(len(cases)))

test = bxl_main(impl = _test, cli_args = {})
