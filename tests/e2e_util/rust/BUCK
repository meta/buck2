load("@fbsource//tools/build_defs:rust_library.bzl", "rust_library")

oncall("build_infra")

# The harness for buck2 e2e tests written in Rust; see `src/lib.rs`. Like the tests, it builds with
# buck only.

rust_library(
    name = "buck2_e2e",
    srcs = glob(["src/**/*.rs"]),
    autocargo = {"ignore_rule": True},
    visibility = ["PUBLIC"],
    deps = [
        "fbsource//third-party/rust:anyhow",
        "fbsource//third-party/rust:futures",
        "fbsource//third-party/rust:hex",
        "fbsource//third-party/rust:regex",
        "fbsource//third-party/rust:serde",
        "fbsource//third-party/rust:serde_json",
        "fbsource//third-party/rust:sha1",
        "fbsource//third-party/rust:sha2",
        "fbsource//third-party/rust:similar",
        "fbsource//third-party/rust:tempfile",
        "fbsource//third-party/rust:tokio",
        "fbsource//third-party/rust:uuid",
        ":buck2_e2e_macros",
    ] + select({
        "DEFAULT": [],
        "ovr_config//os:linux": [
            "fbsource//third-party/rust:libc",
        ],
        "ovr_config//os:macos": [
            "fbsource//third-party/rust:libc",
        ],
        "ovr_config//os:windows": [
            "fbsource//third-party/rust:windows-sys",
        ],
    }),
)

rust_library(
    name = "buck2_e2e_macros",
    srcs = glob(["macros/**/*.rs"]),
    autocargo = {"ignore_rule": True},
    crate_root = "macros/lib.rs",
    proc_macro = True,
    deps = [
        "fbsource//third-party/rust:proc-macro2",
        "fbsource//third-party/rust:quote",
        "fbsource//third-party/rust:syn",
    ],
)
