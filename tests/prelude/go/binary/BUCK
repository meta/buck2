load("@fbcode//buck2/tests/prelude:py_assertion.bzl", "py_assertion")
load("@fbcode_macros//build_defs:export_files.bzl", "export_file")

oncall("golang")

prelude = native

export_file(
    name = "testdata_input",
    src = "testdata/input.txt",
)

prelude.go_binary(
    name = "bin",
    srcs = ["main.go"],
    deps = [
        "//buck2/tests/prelude/go/binary/library:lib",
    ],
)

prelude.go_binary(
    name = "bin_dict_resources",
    srcs = ["main.go"],
    resources = {
        "renamed/input.txt": ":testdata_input",
    },
    deps = [
        "//buck2/tests/prelude/go/binary/library:lib",
    ],
)

prelude.go_binary(
    name = "bin_list_resources",
    srcs = ["main.go"],
    resources = ["testdata/input.txt"],
    deps = [
        "//buck2/tests/prelude/go/binary/library:lib",
    ],
)
py_assertion(
    name = "check_dict_resources_manifest",
    script = """
import json
import sys
manifest = json.load(open(sys.argv[1]))
assert manifest == {
    "renamed/input.txt": "__bin_dict_resources__resources/renamed__input.txt/input.txt",
}, manifest
""",
    script_args = ["$(location :bin_dict_resources[resources])"],
)

py_assertion(
    name = "check_list_resources_manifest",
    script = """
import json
import sys
manifest = json.load(open(sys.argv[1]))
assert manifest == {
    "testdata/input.txt": "__bin_list_resources__resources/testdata__input.txt/input.txt",
}, manifest
""",
    script_args = ["$(location :bin_list_resources[resources])"],
)

py_assertion(
    name = "check_output",
    script = """
import subprocess
import sys
assert (
    subprocess.check_output([sys.argv[1]]).decode().strip()
    == "hello world"
)
""",
    script_args = ["$(exe_target :bin)"],
)

py_assertion(
    name = "check_exe_extension",
    script = """
import sys
from pathlib import Path
import platform
if platform.system() == "Windows":
    assert (
        Path(sys.argv[1]).suffix == ".exe"
    )
""",
    script_args = ["$(exe_target :bin)"],
)
